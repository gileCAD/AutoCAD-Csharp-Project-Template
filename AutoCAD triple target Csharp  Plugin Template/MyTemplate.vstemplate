<VSTemplate Version="3.0.0" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" Type="Project">
	<TemplateData>
		<FrameworkVersions>net48;net8.0-windows;net10.0-windows</FrameworkVersions>
		<TargetPlatformName>x64</TargetPlatformName>
	
		<!-- Change the name and description as desired -->
		<Name>AutoCAD triple target Plugin</Name>
		<Description>AutoCAD triple target Plugin C# project (.NET Framework 4.8 and .NET 8 / 10.0)</Description>
	
		<ProjectType>CSharp</ProjectType>
		<ProjectSubType>
		</ProjectSubType>
		<SortOrder>1000</SortOrder>
		<CreateNewFolder>true</CreateNewFolder>
	
		<!-- Change the default project name as desired -->
		<DefaultName>AcadTripleTargetPlugin</DefaultName>
	
		<ProvideDefaultName>true</ProvideDefaultName>
		<LocationField>Enabled</LocationField>
		<EnableLocationBrowseButton>true</EnableLocationBrowseButton>
		<CreateInPlace>true</CreateInPlace>
		<Icon>AcadCsTemplateIcon.ico</Icon>
	</TemplateData>
	<TemplateContent>
		<Project TargetFileName="AutocadTripleTargetPlugin.csproj" File="AutocadTripleTargetPlugin.csproj" ReplaceParameters="true">
			<Folder Name="Properties" TargetFolderName="Properties">
				<ProjectItem ReplaceParameters="true"  TargetFileName="launchSettings.json">launchSettings.json</ProjectItem>
				<ProjectItem ReplaceParameters="true" TargetFileName="Resources.resx">Resources.resx</ProjectItem>
				<ProjectItem ReplaceParameters="true" TargetFileName="Resources.Designer.cs">Resources.Designer.cs</ProjectItem>
			</Folder>
			<ProjectItem ReplaceParameters="true" TargetFileName="Commands.cs">Commands.cs</ProjectItem>
			<ProjectItem ReplaceParameters="true" TargetFileName="Initialization.cs">Initialization.cs</ProjectItem>
			<ProjectItem ReplaceParameters="true" TargetFileName="start.scr">start.scr</ProjectItem>
		</Project>
	</TemplateContent>
</VSTemplate>